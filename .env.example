# 🌍 AI Tutor Platform - Environment Configuration

# -----------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Recommended: Create a free serverless project on Neon.tech or Supabase.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# IMPORTANT: Most cloud providers REQUIRE ?sslmode=require for Prisma to connect.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# 2. CACHE & QUEUE (Redis)
# -----------------------------------------------------------------------------
# Recommended: Create a free serverless Redis on Upstash.com.
# Format: rediss://USER:PASSWORD@HOST:PORT
# IMPORTANT: Use 'rediss://' (with double 's') for SSL/TLS connections on Upstash.
REDIS_URL="rediss://default:yourpassword@your-host.upstash.io:6379"

# -----------------------------------------------------------------------------
# 3. AI MODELS (Google Gemini)
# -----------------------------------------------------------------------------
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL_FLASH="gemini-1.5-flash"
GEMINI_MODEL_PRO="gemini-1.5-pro"

# -----------------------------------------------------------------------------
# 4. SECURITY (JWT)
# -----------------------------------------------------------------------------
# Generate long random strings (e.g., openssl rand -base64 32)
JWT_SECRET="at_least_32_chars_long_random_string_secret"
JWT_REFRESH_SECRET="at_least_32_chars_long_random_string_refresh_secret"

# -----------------------------------------------------------------------------
# 5. NETWORKING
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT_API=4000
PORT_WEB=3000

# For local development: http://localhost:4000/api
# For production: https://your-backend-api.railway.app/api
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"

# Set to your production domain (e.g., .yourdomain.com) for cross-subdomain cookies.
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false" # Set to 'true' in production (requires HTTPS)

# -----------------------------------------------------------------------------
# 6. OBSERVABILITY (Optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=""
POSTHOG_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
