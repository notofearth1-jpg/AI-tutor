{
  "extends": "../../tsconfig.paths.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true
  }
}
